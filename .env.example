FILESCAN_DEBUG=false
FILESCAN_MAX_UPLOAD_BYTES=33554432
FILESCAN_UPLOAD_DIR=/tmp/filescan/uploads
FILESCAN_RESULTS_DIR=/tmp/filescan/results
FILESCAN_MIME_ALLOWLIST=
FILESCAN_MIME_DENYLIST=audio/,video/
FILESCAN_API_KEYS=dev-demo-key
FILESCAN_RATE_LIMIT_PER_MINUTE=60
FILESCAN_CLAMAV_ENABLED=true
FILESCAN_CLAMAV_HOST=127.0.0.1
FILESCAN_CLAMAV_PORT=3310
FILESCAN_YARA_ENABLED=true
FILESCAN_YARA_RULES_DIR=./rules/yara
FILESCAN_PRECHECK_ENABLED=true
FILESCAN_PRECHECK_HIGH_ENTROPY=7.2
FILESCAN_ARCHIVE_SCAN_ENABLED=true
FILESCAN_ARCHIVE_MAX_MEMBERS=50
FILESCAN_ARCHIVE_MAX_DEPTH=1
FILESCAN_OLETOOLS_ENABLED=true

# Optional engines (graceful if binary/key missing)
FILESCAN_LMD_ENABLED=true
FILESCAN_LMD_BIN=maldet
FILESCAN_CAPA_ENABLED=true
FILESCAN_CAPA_BIN=capa
FILESCAN_CAPA_RULES_DIR=/opt/capa-rules
FILESCAN_FLOSS_ENABLED=true
FILESCAN_FLOSS_BIN=floss
# Optional remote hash intel (no file upload). Get Auth-Key at:
#   https://auth.abuse.ch/
# Related UIs: https://bazaar.abuse.ch/  https://yaraify.abuse.ch/
FILESCAN_ABUSECH_ENABLED=true
FILESCAN_ABUSECH_AUTH_KEY=
FILESCAN_ABUSECH_API_URL=https://mb-api.abuse.ch/api/v1

FILESCAN_CACHE_ENABLED=true
FILESCAN_CACHE_PATH=/tmp/filescan/hash_cache.json
FILESCAN_CACHE_TTL_SECONDS=604800
FILESCAN_ALLOWLIST_PATH=/tmp/filescan/allowlist.json
FILESCAN_DENYLIST_PATH=/tmp/filescan/denylist.json
FILESCAN_FUZZY_HASH_ENABLED=true
FILESCAN_FUZZY_MATCH_ENABLED=true
FILESCAN_FUZZY_SSDEEP_THRESHOLD=50
FILESCAN_FUZZY_TLSH_MAX_DISTANCE=50
FILESCAN_ARCHIVE_MAX_DEPTH=2

# YARAify reuses FILESCAN_ABUSECH_AUTH_KEY unless this is set
FILESCAN_YARAIFY_ENABLED=true
FILESCAN_YARAIFY_AUTH_KEY=
FILESCAN_YARAIFY_API_URL=https://yaraify-api.abuse.ch/api/v1
